pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {

        AWS_REGION = 'ap-south-1'

        ACCOUNT_ID = '052223515619'

        REPOSITORY = 'frontend'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_URI = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${REPOSITORY}"

        EKS_CLUSTER = 'demo-cluster'

        SERVICE_NAME = 'frontend'

        K8S_NAMESPACE = 'development'
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm

            }

        }

        stage('Login to Amazon ECR') {

            steps {

                sh """
                aws ecr get-login-password \
                --region ${AWS_REGION} | \
                docker login \
                --username AWS \
                --password-stdin \
                ${ECR_URI}
                """

            }

        }

        stage('Build Docker Image') {

            steps {

                sh """
                  docker build -t ${REPOSITORY}:${IAMGE_TAG} .
                """

            }

        }


        stage('Tag Docker Image') {

            steps {

                sh """

                docker tag ${REPOSITORY}:${IMAGE_TAG} ${ECR_URI}:${IMAGE_TAG}

                docker tag ${REPOSITORY}:${IMAGE_TAG} ${ECR_URI}:latest

                """

            }

        }

        stage('Push Docker Image') {

            steps {

                sh """

                docker push ${ECR_URI}:${IMAGE_TAG}

                docker push ${ECR_URI}:latest

                """

            }

        }

        stage('Configure kubectl') {

            steps {

                sh """

                aws eks update-kubeconfig \
                --region ${AWS_REGION} \
                --name ${EKS_CLUSTER}

                """

            }

        }

        stage('Deploy to EKS') {

            steps {

                sh """

                kubectl set image deployment/${SERVICE_NAME} \
                ${SERVICE_NAME}=${ECR_URI}:${IMAGE_TAG} \
                -n ${K8S_NAMESPACE}

                """

            }

        }

        stage('Verify Rollout') {

            steps {

                sh """

                kubectl rollout status deployment/${SERVICE_NAME} \
                -n ${K8S_NAMESPACE}

                """

            }

        }

        stage('Verify Deployment') {

            steps {

                sh """

                kubectl get pods -n ${K8S_NAMESPACE}

                kubectl get svc -n ${K8S_NAMESPACE}

                kubectl get ingress -n ${K8S_NAMESPACE}

                kubectl get deployment -n ${K8S_NAMESPACE}

                """

            }

        }

    }

    post {

        success {

            echo "Deployment Successful"

        }

        failure {

            sh """

            kubectl rollout undo deployment/${SERVICE_NAME} \
            -n ${K8S_NAMESPACE} || true

            """

        }

        always {

            sh """

            docker image prune -af || true

            """

            cleanWs()

        }

    }

}